"use client";

import { useState } from "react";

export default function NewNote() {
  const [text, setText] = useState("");

  async function save() {
    const id = crypto.randomUUID();
    await fetch(`/note/${id}`, {
      method: "POST",
      body: text
    });
    location.href = "/";
  }

  return (
    <div>
      <h1 className="text-3xl mb-4">新しいノート</h1>

      <textarea
        className="w-full h-40 p-2 border border-pink-300 rounded"
        value={text}
        onChange={(e) => setText(e.target.value)}
      />

      <button
        onClick={save}
        className="mt-4 block w-full bg-pink-500 text-white p-2 rounded"
      >
        保存
      </button>
    </div>
  );
}
