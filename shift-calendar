<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#ff8fbd">
<title>シフトカレンダー</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff4f8;--card:#fff;--tx:#5a3a4a;--mu:#c08aa3;--ln:#ffd9e8;--ac:#ff6fa8;--ac2:#ffa6c9;--pv:#ff6fa8;--wk:#a58bff;--sun:#ff5c8a;--sat:#7fa8ff;--sh:0 4px 14px rgba(255,111,168,.15)}
*{box-sizing:border-box}
body{margin:0;font-family:"Kiwi Maru","Hiragino Maru Gothic ProN","Hiragino Maru Gothic Pro","M PLUS Rounded 1c","Kosugi Maru",-apple-system,"Hiragino Sans",sans-serif;background:var(--bg);color:var(--tx);-webkit-tap-highlight-color:transparent;padding-bottom:env(safe-area-inset-bottom)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,select{font:inherit;font-size:16px;color:var(--tx);background:#fff8fb;border:1.5px solid var(--ln);border-radius:12px;padding:7px 10px;min-width:0;outline:none}
input:focus,select:focus{border-color:var(--ac2);box-shadow:0 0 0 3px #ffe3ee}
input[type=color]{padding:2px;width:42px;height:36px}
input[type=checkbox]{width:20px;height:20px;accent-color:var(--ac)}
header{position:sticky;top:0;z-index:5;background:linear-gradient(135deg,#ff8fbd,#ffb8d4);color:#fff;padding-top:env(safe-area-inset-top);border-radius:0 0 22px 22px;box-shadow:var(--sh)}
.top{display:flex;align-items:center;gap:4px;padding:10px 12px 4px}
.top h1{flex:1;margin:0;font-size:19px;text-align:center;letter-spacing:.05em}
.top button{font-size:22px;width:40px;height:36px;border-radius:50%;background:rgba(255,255,255,.25)}
.top #today{font-size:13px;width:auto;padding:0 12px;border-radius:99px;background:#fff;color:var(--ac);font-weight:500}
.tabs{display:flex;gap:6px;padding:6px 10px 10px}
.tabs button{flex:1;padding:8px 0;font-size:14px;color:#fff;border-radius:99px;opacity:.85}
.tabs button.on{background:#fff;color:var(--ac);font-weight:500;opacity:1;box-shadow:0 2px 8px rgba(255,80,140,.25)}
main{max-width:760px;margin:0 auto}
.bar{display:flex;gap:6px;padding:8px 10px;overflow-x:auto;align-items:center}
.chip{padding:6px 14px;border:1.5px solid var(--ln);border-radius:99px;font-size:13px;white-space:nowrap;background:#fff;color:var(--tx)}
.chip.on{background:var(--ac);color:#fff;border-color:var(--ac);box-shadow:0 2px 8px rgba(255,111,168,.35)}
.wd{display:grid;grid-template-columns:repeat(7,1fr);font-size:11px;text-align:center;color:var(--mu);padding:4px 8px;font-weight:500}
.wd div:first-child{color:var(--sun)}.wd div:last-child{color:var(--sat)}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;padding:0 6px}
.cell{background:#fff;min-height:84px;padding:2px 2px 3px;overflow:hidden;cursor:pointer;position:relative;border-radius:10px;box-shadow:0 1px 3px rgba(255,111,168,.12)}
.cell.out{opacity:.4}
.cell.hl{outline:2px solid var(--ac);outline-offset:-2px}
.dn{font-size:12px;width:22px;height:22px;line-height:22px;text-align:center;border-radius:50%;font-weight:500}
.sun .dn,.hol .dn{color:var(--sun)}.sat .dn{color:var(--sat)}
.td{background:#fff0f6}.td .dn{background:var(--ac);color:#fff!important}
.hn{font-size:8px;color:var(--sun);position:absolute;top:5px;left:24px;right:2px;white-space:nowrap;overflow:hidden}
.sb{display:block;font-size:10px;color:#fff;border-radius:99px;padding:0 5px;margin-top:2px;white-space:nowrap;overflow:hidden;font-weight:500}
.ev{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 4px;margin-top:2px;border-radius:6px}
.ev.p{background:#ffe3ee;color:#d6427e}.ev.w{background:#ede8ff;color:#6b53d6}
.more{font-size:9px;color:var(--mu)}
.card{background:#fff;margin:10px;border-radius:20px;padding:14px;border:1.5px solid var(--ln);box-shadow:var(--sh)}
.card h3{margin:0 0 8px;font-size:14px;color:var(--ac)}
.kv{display:flex;justify-content:space-between;padding:6px 0;font-size:14px;border-bottom:1.5px dotted var(--ln)}
.kv:last-child{border:0}
.kv b{font-variant-numeric:tabular-nums}
.big{font-size:28px;font-weight:500;text-align:right;font-variant-numeric:tabular-nums;color:var(--ac)}
.minus{color:#e0608f}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px}
.stat{background:#fff;border:1.5px solid var(--ln);border-radius:16px;padding:8px;text-align:center;box-shadow:var(--sh)}
.stat small{display:block;font-size:11px;color:var(--mu)}
.stat b{font-size:16px;font-variant-numeric:tabular-nums;color:var(--ac)}
.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:6px 0}
.row>label{display:flex;flex-direction:column;font-size:11px;color:var(--mu);gap:2px}
.row input[type=number]{width:90px}
.row input[type=time]{width:110px}
.row input.w{width:140px}
.item{border:1.5px solid var(--ln);border-radius:16px;padding:10px;margin:8px 0;border-left:6px solid var(--ln);background:#fffafc}
.btn{padding:8px 14px;border-radius:99px;border:1.5px solid var(--ln);font-size:13px;background:#fff;color:var(--tx)}
.btn.pr{background:var(--ac);color:#fff;border-color:var(--ac);box-shadow:0 2px 8px rgba(255,111,168,.35)}
.btn.dg{color:#e0608f}
.calc{font-size:13px;background:#fff0f6;border-radius:14px;padding:10px;margin-top:8px;line-height:1.7}
.ph{padding:12px 12px 0;font-size:13px;font-weight:500}
#modal{position:fixed;inset:0;background:rgba(120,40,80,.3);z-index:20;display:flex;align-items:flex-end;justify-content:center}
#modal[hidden]{display:none}
#modal2{position:fixed;inset:0;background:rgba(120,40,80,.3);z-index:21;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:#fff;width:100%;max-width:640px;max-height:90vh;overflow:auto;border-radius:26px 26px 0 0;padding:12px 14px calc(20px + env(safe-area-inset-bottom))}
.sh{display:flex;align-items:center;justify-content:space-between;position:sticky;top:-12px;background:#fff;padding:6px 0;z-index:1}
.sh h2{margin:0;font-size:17px;color:var(--ac)}
.sheet h3{color:var(--ac);font-size:14px;margin:14px 0 4px}
.note{font-size:11px;color:var(--mu);margin:4px 0}
[hidden]{display:none!important}
</style>
</head>
<body>
<header>
  <div class="top"><button id="prev">‹</button><h1 id="title"></h1><button id="next">›</button><button id="today">今日</button></div>
  <nav class="tabs"><button data-tab="cal" class="on">カレンダー</button><button data-tab="pay">給与</button><button data-tab="set">設定</button></nav>
</header>
<main>
  <section id="cal"></section>
  <section id="pay" hidden></section>
  <section id="set" hidden></section>
</main>
<div id="modal" hidden><div class="sheet" id="sheet"></div></div>
<input type="file" id="file" accept="application/json" hidden>
<input type="file" id="slipfile" accept=".csv,.xlsx,.xls,.tsv,.txt,text/csv" hidden>
<div id="modal2" hidden><div class="sheet" id="sheet2"></div></div>
<script>
const $=s=>document.querySelector(s);
const LS='shiftcal-v1';
const clone=o=>JSON.parse(JSON.stringify(o));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const COLORS=['#ff8fbd','#b08cff','#6fd3b8','#ffb36b','#7fb8ff'];
const DEDS=[
  {name:'健康保険',cat:'ins',type:'fixed',value:0},
  {name:'厚生年金',cat:'ins',type:'fixed',value:0},
  {name:'雇用保険',cat:'ins',type:'rate',value:0.55},
  {name:'所得税',cat:'tax',type:'fixed',value:0},
  {name:'住民税',cat:'tax',type:'fixed',value:0}
];
function newJob(n,id){return{id:id||'j'+Date.now().toString(36),name:'勤務'+n,short:String(n),color:COLORS[(n-1)%COLORS.length],
  brk:0,wage:1200,transport:0,cutoff:0,cutoff2:'',round:'floor',nightRate:25,nightStart:19,nightEnd:0,otRate:25,otHours:8,deds:clone(DEDS),last:{}}}
let S,D;
(function load(){
  try{const j=JSON.parse(localStorage.getItem(LS));if(j&&j.S){S=j.S;D=j.D||{}}}catch(e){}
  if(!S){S={jobs:[newJob(1,'s1'),newJob(2,'s2')]};D={};}
  if(!S.jobs){const o=S;S={jobs:(o.shifts||[]).map((t,i)=>{const b=newJob(i+1,t.id);
    for(const f of['transport','cutoff','cutoff2','round','nightRate','nightStart','nightEnd','otRate','otHours'])if(o[f]!=null)b[f]=o[f];
    if(o.deds)b.deds=clone(o.deds);b.wage=(t.wage!==''&&t.wage!=null)?+t.wage:(+o.wage||1200);
    b.name=(t.name==='早番'||t.name==='遅番')?'勤務'+(i+1):t.name;b.short=(t.name==='早番'||t.name==='遅番')?String(i+1):t.short;
    b.color=t.color||b.color;b.brk=t.brk||0;b.last=t.last||{};if(+b.nightStart===22&&+b.nightEnd===5){b.nightStart=19;b.nightEnd=0}return b})};
    if(!S.jobs.length)S.jobs=[newJob(1,'s1')];}
  S.jobs.forEach(J=>(J.deds||[]).forEach(x=>{if(!x.cat)x.cat=x.social?'ins':/税/.test(x.name)?'tax':'other';delete x.base;delete x.social}));
})();
function save(){try{localStorage.setItem(LS,JSON.stringify({S,D}))}catch(e){}}

const now=new Date();let Y=now.getFullYear(),M=now.getMonth(),TAB='cal',FIL='all',OPEN=null,PAYJ='all',SETJ=0;
const pad=n=>String(n).padStart(2,'0');
const key=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const tm=s=>{if(!s)return null;const[a,b]=s.split(':');return +a*60+ +b};
const hm=m=>`${Math.floor(m/60)}:${pad(m%60)}`;
const yen=n=>'¥'+Math.round(n).toLocaleString();
const rnd=(J,x)=>J.round==='ceil'?Math.ceil(x-1e-9):J.round==='round'?Math.round(x):Math.floor(x+1e-9);
const jobOf=id=>S.jobs.find(j=>j.id===id);
const WD=['日','月','火','水','木','金','土'];
const CATS=[['ins','社会保険','率は総支給に対して'],['tax','税金','率は（課税支給−社会保険）に対して'],['other','その他','率は総支給に対して']];

/* 祝日 */
const HC={};
function hols(y){
  if(HC[y])return HC[y];
  const h={};const set=(m,d,n)=>h[`${y}-${pad(m)}-${pad(d)}`]=n;
  const nth=(m,n)=>{const f=new Date(y,m-1,1).getDay();return 1+((8-f)%7)+(n-1)*7};
  set(1,1,'元日');set(1,nth(1,2),'成人の日');set(2,11,'建国記念の日');set(2,23,'天皇誕生日');
  set(3,Math.floor(20.8431+0.242194*(y-1980)-Math.floor((y-1980)/4)),'春分の日');
  set(4,29,'昭和の日');set(5,3,'憲法記念日');set(5,4,'みどりの日');set(5,5,'こどもの日');
  set(7,nth(7,3),'海の日');set(8,11,'山の日');set(9,nth(9,3),'敬老の日');
  set(9,Math.floor(23.2488+0.242194*(y-1980)-Math.floor((y-1980)/4)),'秋分の日');
  set(10,nth(10,2),'スポーツの日');set(11,3,'文化の日');set(11,23,'勤労感謝の日');
  for(const k of Object.keys(h)){const d=new Date(k+'T00:00');if(d.getDay()===0){const n=new Date(d);do{n.setDate(n.getDate()+1)}while(h[key(n)]);h[key(n)]='振替休日';}}
  for(let d=new Date(y,0,2);d.getFullYear()===y;d.setDate(d.getDate()+1)){const p=new Date(d);p.setDate(p.getDate()-1);const n=new Date(d);n.setDate(n.getDate()+1);if(!h[key(d)]&&d.getDay()!==0&&h[key(p)]&&h[key(n)])h[key(d)]='国民の休日';}
  return HC[y]=h;
}
const holName=d=>hols(d.getFullYear())[key(d)]||'';

/* 計算（会社ごと） */
function calcDay(k,J){
  const r={min:0,night:0,ot:0,otNight:0,base:0,nightP:0,otP:0,pay:0};
  const d=D[k];if(!d||!d.shifts)return r;
  const segs=d.shifts.filter(sh=>sh.sid===J.id).map(sh=>{
    let s=tm(sh.start),e=tm(sh.end);if(s==null||e==null)return null;if(e<=s)e+=1440;
    const brk=Math.min(+sh.brk||0,e-s);let bs=sh.bs?tm(sh.bs):null;
    if(bs!=null){if(bs<s)bs+=1440}else bs=s+Math.floor((e-s-brk)/2);
    const w=+(sh.wage!==''&&sh.wage!=null?sh.wage:J.wage)||0;
    return{s,e,brk,bs,w};
  }).filter(Boolean).sort((a,b)=>a.s-b.s);
  const th=(+J.otHours||0)*60,ns=(+J.nightStart||0)*60,ne=(+J.nightEnd||0)*60;let cum=0;
  for(const g of segs)for(let m=g.s;m<g.e;m++){
    if(m>=g.bs&&m<g.bs+g.brk)continue;
    const h=((m%1440)+1440)%1440;const isN=ns>ne?(h>=ns||h<ne):(h>=ns&&h<ne);
    const isO=th>0&&cum>=th;cum++;const pm=g.w/60;
    r.min++;r.base+=pm;
    if(isN){r.night++;r.nightP+=pm*(+J.nightRate||0)/100}
    if(isO){r.ot++;r.otP+=pm*(+J.otRate||0)/100;if(isN)r.otNight++}
  }
  r.pay=r.base+r.nightP+r.otP;return r;
}
const endOf=(y,m,c)=>c?new Date(y,m,c):new Date(y,m+1,0);
function periods(J,y,m){
  let cs=[+J.cutoff||0];if(J.cutoff2!==''&&J.cutoff2!=null&&+J.cutoff2!==cs[0])cs.push(+J.cutoff2);
  cs.sort((a,b)=>(a||99)-(b||99));
  return cs.map((c,i)=>{const e=endOf(y,m,c);const pe=i?endOf(y,m,cs[i-1]):endOf(y,m-1,cs[cs.length-1]);return{s:new Date(pe.getFullYear(),pe.getMonth(),pe.getDate()+1),e}});
}
function summary(J,p){
  const t={days:0,min:0,night:0,ot:0,otNight:0,base:0,nightP:0,otP:0};
  for(const d=new Date(p.s);d<=p.e;d.setDate(d.getDate()+1)){
    const r=calcDay(key(d),J);if(r.min>0)t.days++;
    for(const f in r)if(f in t&&f!=='days')t[f]+=r[f];
  }
  t.base=rnd(J,t.base);t.nightP=rnd(J,t.nightP);t.otP=rnd(J,t.otP);
  t.pay=t.base+t.nightP+t.otP;t.trans=t.days*(+J.transport||0);t.gross=t.pay+t.trans;
  const amt=(x,b)=>t.gross>0?(x.type==='rate'?rnd(J,b*(+x.value||0)/100):Math.round(+x.value||0)):0;
  const ds=J.deds||[];t.deds=[];t.cat={ins:0,tax:0,other:0};
  ds.filter(x=>x.cat==='ins').forEach(x=>{const a=amt(x,t.gross);t.cat.ins+=a;t.deds.push({name:x.name,cat:'ins',a})});
  ds.filter(x=>x.cat==='tax').forEach(x=>{const a=amt(x,Math.max(0,t.pay-t.cat.ins));t.cat.tax+=a;t.deds.push({name:x.name,cat:'tax',a})});
  ds.filter(x=>x.cat==='other').forEach(x=>{const a=amt(x,t.gross);t.cat.other+=a;t.deds.push({name:x.name,cat:'other',a})});
  t.dedSum=t.deds.reduce((a,b)=>a+b.a,0);t.net=t.gross-t.dedSum;t.p=p;return t;
}
function monthSum(J,y,m){const r={days:0,min:0,gross:0,pay:0,net:0,dedSum:0};periods(J,y,m).forEach(p=>{const t=summary(J,p);for(const f in r)r[f]+=t[f]});return r}
const ymOf=(y,m)=>`${y}-${pad(m+1)}`;
function actualOf(J,y,m){const sl=(J.slips||[]).filter(x=>x.ym===ymOf(y,m));if(!sl.length)return null;
  const r={gross:0,trans:0,ded:0,net:0,items:{},n:sl.length};
  sl.forEach(x=>{r.gross+=+x.gross||0;r.trans+=+x.trans||0;x.items.forEach(it=>{r.items[it.name]=(r.items[it.name]||0)+(+it.a||0);r.ded+=+it.a||0});r.net+=x.net!==''&&x.net!=null?+x.net:(+x.gross||0)-x.items.reduce((a,b)=>a+(+b.a||0),0)});
  r.pay=r.gross-r.trans;return r}
function monthBest(J,y,m){const a=actualOf(J,y,m);if(a)return{gross:a.gross,pay:a.pay,net:a.net,act:1};const t=monthSum(J,y,m);return{gross:t.gross,pay:t.pay,net:t.net,act:0}}
function allMonth(y,m){const r={days:0,min:0,gross:0,pay:0,net:0};S.jobs.forEach(J=>{const t=monthSum(J,y,m);for(const f in r)r[f]+=t[f]});return r}

/* 描画 */
function render(){
  $('#title').textContent=`${Y}年${M+1}月`;
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.tab===TAB));
  ['cal','pay','set'].forEach(id=>$('#'+id).hidden=id!==TAB);
  if(TAB==='cal')renderCal();else if(TAB==='pay')renderPay();else renderSet();
}
function renderCal(){
  const first=new Date(Y,M,1),dim=new Date(Y,M+1,0).getDate(),off=first.getDay();
  const cells=Math.ceil((off+dim)/7)*7;const tk=key(new Date());
  let h=`<div class="bar">${[['all','すべて'],['p','プライベート'],['w','仕事']].map(([v,l])=>`<button class="chip ${FIL===v?'on':''}" data-f="${v}">${l}</button>`).join('')}</div>`;
  h+=`<div class="wd">${WD.map(w=>`<div>${w}</div>`).join('')}</div><div class="grid">`;
  for(let i=0;i<cells;i++){
    const d=new Date(Y,M,1-off+i),k=key(d),dd=D[k]||{},hn=holName(d);
    const cls=['cell',d.getMonth()!==M?'out':'',k===tk?'td':'',d.getDay()===0?'sun':'',d.getDay()===6?'sat':'',hn?'hol':'',OPEN===k?'hl':''].join(' ');
    let c=`<div class="dn">${d.getDate()}</div>${hn?`<div class="hn">${esc(hn)}</div>`:''}`;
    if(FIL!=='p')(dd.shifts||[]).forEach(s=>{const J=jobOf(s.sid);c+=`<span class="sb" style="background:${J?J.color:'#c9a3b5'}">${esc(J?J.short||J.name:'?')} ${esc(s.start||'')}${s.end?'-'+esc(s.end):''}</span>`});
    const evs=(dd.events||[]).filter(e=>FIL==='all'||e.cat===FIL).sort((a,b)=>(a.time||'').localeCompare(b.time||''));
    evs.slice(0,3).forEach(e=>c+=`<div class="ev ${e.cat}">${esc(e.t||'(無題)')}</div>`);
    if(evs.length>3)c+=`<div class="more">+${evs.length-3}</div>`;
    h+=`<div class="${cls}" data-k="${k}">${c}</div>`;
  }
  h+='</div>';
  const t=allMonth(Y,M);
  h+=`<div class="stats"><div class="stat"><small>勤務日数</small><b>${t.days}日</b></div><div class="stat"><small>実働</small><b>${hm(t.min)}</b></div><div class="stat"><small>総支給見込</small><b>${yen(t.gross)}</b></div></div>`;
  $('#cal').innerHTML=h;
}
function jobChips(cur,attr,withAll){
  return `<div class="bar">${withAll?`<button class="chip ${cur==='all'?'on':''}" ${attr}="all">合計</button>`:''}${S.jobs.map((J,i)=>{const v=withAll?J.id:i;const on=String(cur)===String(v);return `<button class="chip ${on?'on':''}" ${attr}="${v}" style="${on?`background:${J.color};border-color:${J.color}`:`border-color:${J.color}`}">${esc(J.name)}</button>`}).join('')}</div>`;
}
function renderPay(){
  if(PAYJ!=='all'&&!jobOf(PAYJ))PAYJ='all';
  const f=d=>`${d.getMonth()+1}/${d.getDate()}`;
  let h=jobChips(PAYJ,'data-pj',true);
  if(PAYJ==='all'){
    const m=allMonth(Y,M);
    h+=`<div class="stats"><div class="stat"><small>勤務日数</small><b>${m.days}日</b></div><div class="stat"><small>実働</small><b>${hm(m.min)}</b></div><div class="stat"><small>総支給</small><b>${yen(m.gross)}</b></div></div>
    <div class="card"><h3>${M+1}月分 手取り合計</h3><div class="big">${yen(m.net)}</div></div>
