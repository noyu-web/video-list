  <div class="calc" id="slipcalc">控除合計 ${yen(x.items.reduce((a,b)=>a+(+b.a||0),0))}　手取り ${yen(slipNet(x))}</div>
  <div class="bar" style="padding:12px 0 0"><button class="btn dg" data-a="delSlip">この明細を削除</button></div>`;
}
$('#modal2').onclick=e=>{if(e.target.id==='modal2')closeSlip()};
$('#sheet2').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b)return;const{J,x}=curSlip();
  switch(b.dataset.a){case'close':return closeSlip();case'addI':x.items.push({name:'',cat:'other',a:0});break;case'delI':x.items.splice(+b.dataset.i,1);break;
    case'delSlip':if(!confirm('削除？'))return;J.slips=J.slips.filter(s=>s.id!==x.id);return closeSlip();}
  save();renderSlip()});
function slipInput(e){const el=e.target;const{x}=curSlip();if(!x)return;
  if(el.dataset.f){const f=el.dataset.f;x[f]=f==='ym'?el.value:(el.value===''?'':+el.value);if(f==='ym'){x.ym=el.value;x.k=el.value}}
  else if(el.dataset.g){const it=x.items[+el.dataset.i];it[el.dataset.g]=el.dataset.g==='a'?(el.value===''?0:+el.value):el.value}
  save();const c=$('#slipcalc');if(c)c.textContent=`控除合計 ${yen(x.items.reduce((a,b)=>a+(+b.a||0),0))}　手取り ${yen(slipNet(x))}`}
$('#sheet2').addEventListener('input',slipInput);$('#sheet2').addEventListener('change',slipInput);

function num(v){if(v==null||v==='')return null;if(typeof v==='number')return v;let s=String(v).trim();let neg=/^[△▲\-−]/.test(s);s=s.replace(/[^\d.]/g,'');if(!s)return null;const n=parseFloat(s);return isNaN(n)?null:(neg?-n:n)}
function parseYM(v){
  if(v==null||v==='')return null;
  const f=d=>({ym:`${d.getFullYear()}-${pad(d.getMonth()+1)}`,k:`${d.getFullYear()}-${pad(d.getMonth()+1)}`});
  if(v instanceof Date&&!isNaN(v))return f(v);
  if(typeof v==='number'){if(v>20000&&v<80000){const d=new Date(Math.round((v-25569)*864e5));return{ym:`${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}`,k:`${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}`}}if(v>=190001&&v<=210012)return parseYM(String(v).slice(0,4)+'/'+String(v).slice(4));return null}
  let s=String(v).normalize('NFKC');let y,m,d;let r;
  if(r=s.match(/(?:令和|R)\s*(\d+|元)\s*年?\D*?(\d{1,2})\s*月?/i)){y=2018+(r[1]==='元'?1:+r[1]);m=+r[2]}
  else if(r=s.match(/(\d{4})\s*[年\/\-.]\s*(\d{1,2})(?:\s*[月\/\-.]\s*(\d{1,2}))?/)){y=+r[1];m=+r[2];d=r[3]?+r[3]:0}
  else if(r=s.match(/^(\d{4})(\d{2})$/)){y=+r[1];m=+r[2]}
  else if(r=s.match(/(\d{1,2})\s*月/)){y=Y;m=+r[1]}
  if(!y||!m||m>12)return null;return{ym:`${y}-${pad(m)}`,k:`${y}-${pad(m)}`+(d?`-${pad(d)}`:'')};
}
function colType(h){const s=String(h??'').normalize('NFKC').replace(/\s/g,'');if(!s)return null;
  if(/控除(合計|計|額計)|控除額$/.test(s))return'dedTotal';
  if(/差引|手取|振込|支払額/.test(s))return'net';
  if(/総支給|支給(合計|額計|計|総額)|総額/.test(s))return'gross';
  if(/課税/.test(s))return'taxable';
  if(/交通|通勤/.test(s))return'trans';
  if(/年月|支給日|支払日|対象|日付|^月$|^年$|期間|明細/.test(s))return'date';
  if(/保険|年金|税|組合費|天引/.test(s))return'ded';
  return null}
function parseSlips(rows){
  rows=rows.filter(r=>r&&r.some(c=>c!==''&&c!=null));if(!rows.length)return[];
  const score=arr=>arr.filter(c=>colType(c)).length;
  let br=0,bs=0;rows.slice(0,15).forEach((r,i)=>{const s=score(r);if(s>bs){bs=s;br=i}});
  let bc=0,cs=0;for(let c=0;c<4;c++){const s=score(rows.map(r=>r[c]));if(s>cs){cs=s;bc=c}}
  if(cs>bs){const w=Math.max(...rows.map(r=>r.length));const t=[];for(let c=0;c<w;c++)t.push(rows.map(r=>r[c]));rows=t.filter(r=>r.some(c=>c!==''&&c!=null));br=bc}
  const H=rows[br].map(colType),names=rows[br].map(c=>String(c??'').trim());
  let dc=H.indexOf('date');const out=[];
  rows.slice(br+1).forEach(r=>{
    let d=dc>=0?parseYM(r[dc]):null;if(!d)for(let i=0;i<r.length&&!d;i++)if(H[i]==null)d=parseYM(r[i]);if(!d)return;
    const get=t=>{const i=H.indexOf(t);return i>=0?num(r[i]):null};
    const items=[];H.forEach((t,i)=>{if(t==='ded'){const a=num(r[i]);if(a!=null)items.push({name:names[i],cat:catGuess(names[i]),a})}});
    let gross=get('gross'),net=get('net'),trans=get('trans')||0;const ds=items.reduce((a,b)=>a+b.a,0);
    if(gross==null&&net!=null)gross=net+(get('dedTotal')??ds);if(gross==null)return;
    out.push({id:'p'+Math.random().toString(36).slice(2,9),ym:d.ym,k:d.k,gross,trans,net:net==null?'':net,items});
  });return out}
function parseCSV(t){const rows=[];let row=[],cur='',q=false;const sep=t.indexOf('\t')>=0&&t.indexOf(',')<0?'\t':',';
  for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c==='"'){if(t[i+1]==='"'){cur+='"';i++}else q=false}else cur+=c}
    else if(c==='"')q=true;else if(c===sep){row.push(cur);cur=''}else if(c==='\n'||c==='\r'){if(c==='\r'&&t[i+1]==='\n')i++;row.push(cur);rows.push(row);row=[];cur=''}else cur+=c}
  if(cur||row.length){row.push(cur);rows.push(row)}return rows}
function loadXLSX(){return new Promise((ok,ng)=>{if(window.XLSX)return ok();const s=document.createElement('script');s.src='https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';s.onload=ok;s.onerror=ng;document.head.appendChild(s)})}
async function readRows(f){
  const buf=await f.arrayBuffer();
  if(/\.(xlsx|xls)$/i.test(f.name)){await loadXLSX();const wb=XLSX.read(buf,{cellDates:true});let all=[];
    for(const n of wb.SheetNames){const r=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:''});const p=parseSlips(r);if(p.length)all=all.concat(p)}return all}
  let t=new TextDecoder('utf-8').decode(buf);if(t.includes('�')){try{t=new TextDecoder('shift_jis').decode(buf)}catch(e){}}
  return parseSlips(parseCSV(t.replace(/^﻿/,'')));
}
function autoDeds(J){
  const sl=(J.slips||[]).slice().sort((a,b)=>a.k.localeCompare(b.k));if(!sl.length)return'明細がありません';
  const names=[...new Set(sl.flatMap(x=>x.items.map(i=>i.name)).filter(Boolean))];const msg=[];
  for(const n of names){
    const has=sl.filter(x=>x.items.some(i=>i.name===n));const amt=x=>x.items.filter(i=>i.name===n).reduce((a,b)=>a+(+b.a||0),0);
    const ex=J.deds.find(d=>d.name===n);const cat=ex?ex.cat:(has[has.length-1].items.find(i=>i.name===n).cat||catGuess(n));
    const last=has.slice(-3).map(amt);let type,value;
    if(last.length&&Math.max(...last)-Math.min(...last)<=1){type='fixed';value=last[last.length-1]}
    else{const rec=has.slice(-6);let a=0,b=0;rec.forEach(x=>{a+=amt(x);const ins=x.items.filter(i=>i.cat==='ins').reduce((p,q)=>p+(+q.a||0),0);
      b+=cat==='tax'?Math.max(0,x.gross-(+x.trans||0)-ins):x.gross});type='rate';value=b?Math.round(a/b*100000)/1000:0}
    if(ex){ex.type=type;ex.value=value;ex.cat=cat}else J.deds.push({name:n,cat,type,value});
    msg.push(`${n}：${type==='fixed'?value.toLocaleString()+'円':value+'%'}`);
  }
  return '控除を自動設定しました\n'+msg.join('\n');
}
$('#slipfile').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;const J=S.jobs[SETJ];
  try{const got=await readRows(f);if(!got.length)return alert('明細を読み取れませんでした（年月と総支給または手取りの列が必要）');
    J.slips=J.slips||[];got.forEach(g=>{const i=J.slips.findIndex(s=>s.k===g.k);if(i>=0)J.slips[i]=Object.assign(g,{id:J.slips[i].id});else J.slips.push(g)});
    const m=autoDeds(J);save();renderSet();alert(`${got.length}件読み込みました\n\n`+m)}
  catch(x){alert('読み込み失敗')}};
render();
