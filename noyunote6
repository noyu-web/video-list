import kv from "../../../lib/kv";

export default async function NotePage({ params }) {
  const id = params.id;

  async function save(data: FormData) {
    "use server";
    const text = data.get("text") as string;
    await kv.hset("notes", { [id]: text });
  }

  const notes = await kv.hgetall("notes") || {};
  const text = notes[id] || "";

  return (
    <form action={save}>
      <textarea
        name="text"
        defaultValue={text}
        className="w-full h-60 p-2 border border-pink-300 rounded"
      />

      <button
        className="mt-4 block w-full bg-pink-500 text-white p-2 rounded"
      >
        保存
      </button>
    </form>
  );
}
