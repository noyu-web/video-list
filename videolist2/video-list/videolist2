function getVideos() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) { Logger.log('シートなし'); return []; }
  const rows = sheet.getDataRange().getValues();
  Logger.log('行数: ' + rows.length);
  if (rows.length <= 1) return [];
  return rows.slice(1).map(r => ({
    id: String(r[0]), title: r[1],
    members: r[2] ? String(r[2]).split(',') : [],
    exchange: r[3],
    genres: r[4] ? String(r[4]) : '[]',
    dates: r[5] ? String(r[5]) : '[]',
    note: r[6],
    tracks: r[7] ? String(r[7]) : '[]'
  }));
}

function saveVideo(data) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) { sheet = ss.insertSheet(SHEET_NAME); sheet.appendRow(['id','title','members','exchange','genres','dates','note','tracks']); }
  const rows = sheet.getDataRange().getValues();
  const v = data.video;
  const row = [v.id, v.title, (v.members||[]).join(','), v.exchange, v.genres||'[]', v.dates||'[]', v.note||'', v.tracks||'[]'];
  if (data.isNew) { sheet.appendRow(row); }
  else { for (let i=1;i<rows.length;i++) { if (String(rows[i][0])===String(v.id)) { sheet.getRange(i+1,1,1,row.length).setValues([row]); break; } } }
  return {ok: true};
}

function deleteVideo(id) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) return {ok: true};
  const rows = sheet.getDataRange().getValues();
  for (let i=1;i<rows.length;i++) { if (String(rows[i][0])===String(id)) { sheet.deleteRow(i+1); break; } }
  return {ok: true};
}

function getConfig() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(PW_SHEET);
  if (!sheet) return {password: null};
  return {password: sheet.getRange(1,1).getValue() || null};
}

function setAdminPassword() {
