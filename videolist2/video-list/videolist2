function fixDuplicates() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(SHEET_NAME);
  const rows = sheet.getDataRange().getValues();
  const header = rows[0];
  const data = rows.slice(1);

  function fixMembers(s){
    return(s?String(s).split(',').map(m=>m.trim()).filter(Boolean):[]).map(m=>m==='全員'?'SixTONES':m);
  }
  function extractBracket(t){
    const n=[];
    const c=t.replace(/【([^】]+)】/g,(_,x)=>{x.split(/[・、]/).forEach(v=>{if(v.trim())n.push(v.trim());});return'';}).trim();
    return{c,n};
  }

  const gmap={};
  data.forEach((r,i)=>{
    const{c}=extractBracket(String(r[1]||'').trim());
    const k=c+'|||'+String(r[5]||'[]');
    if(!gmap[k])gmap[k]=[];
    gmap[k].push(i);
  });

  const used=new Set();
  const nd=[];

  data.forEach((r,i)=>{
    if(used.has(i))return;
    const{c:ct}=extractBracket(String(r[1]||'').trim());
    const k=ct+'|||'+String(r[5]||'[]');
    const grp=gmap[k];
    const mm=new Set();
    let mg=r[4],mt=r[7],mn=String(r[6]||'');

    grp.forEach(idx=>{
      used.add(idx);
      const x=data[idx];
      fixMembers(x[2]).forEach(m=>mm.add(m));
      extractBracket(String(x[1]||'')).n.forEach(n=>mm.add(n));
      if(String(x[7]||'').length>String(mt||'').length)mt=x[7];
      try{
        const g=JSON.parse(x[4]||'[]');
        if(g.length&&g[0].genre!=='SixTONES以外')mg=x[4];
      }catch{}
    });

    if(mm.size===0){
      try{
        const g=JSON.parse(r[4]||'[]');
        if(g.length&&g[0].subgenre)mm.add(g[0].subgenre);
      }catch{}
    }

    const nr=[...r];
    nr[1]=ct;
    nr[2]=[...mm].join(',');
    nr[4]=mg;
    nr[6]=mn;
    nr[7]=mt||'[]';
    nd.push(nr);
    used.add(i);
  });

  sheet.clearContents();
  const all=[header,...nd];
  sheet.getRange(1,1,all.length,header.length).setValues(all);
  Logger.log('完了: '+data.length+'→'+nd.length+'件');
}

