function renameGenre(fromName, toName) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) return {ok:false};
  const rows = sheet.getDataRange().getValues();
  let updated = 0;
  for (let i=1;i<rows.length;i++) {
    let genres;
    try { genres = JSON.parse(rows[i][4] || '[]'); } catch { continue; }
    let changed = false;
    genres.forEach(g => { if (g.genre === fromName) { g.genre = toName; changed = true; } });
    if (changed) {
      sheet.getRange(i+1, 5).setValue(JSON.stringify(genres));
      updated++;
    }
  }
  return {ok:true, updated:updated};
}

