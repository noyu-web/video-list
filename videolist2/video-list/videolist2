function getVideos2() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(SHEET_NAME2);
  if (!sheet) return [];
  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 1) return [];
  return rows.slice(1).map(r => ({
    id: String(r[0]), title: r[1],
    members: r[2] ? String(r[2]).split(',') : [],
    exchange: r[3],
    genres: r[4] ? String(r[4]) : '[]',
    dates: r[5] ? String(r[5]) : '[]',
    note: r[6],
    tracks: r[7] ? String(r[7]) : '[]'
  }));
}

function saveVideo2(data) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(SHEET_NAME2);
  if (!sheet) { sheet = ss.insertSheet(SHEET_NAME2); sheet.appendRow(['id','title','members','exchange','genres','dates','note','tracks']); }
  const rows = sheet.getDataRange().getValues();
  const v = data.video;
  const row = [v.id, v.title, (v.members||[]).join(','), v.exchange, v.genres||'[]', v.dates||'[]', v.note||'', v.tracks||'[]'];
  if (data.isNew) { sheet.appendRow(row); }
  else { for (let i=1;i<rows.length;i++) { if (String(rows[i][0])===String(v.id)) { sheet.getRange(i+1,1,1,row.length).setValues([row]); break; } } }
  return {ok: true};
}

function deleteVideo2(id) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(SHEET_NAME2);
  if (!sheet) return {ok: true};
  const rows = sheet.getDataRange().getValues();
  for (let i=1;i<rows.length;i++) { if (String(rows[i][0])===String(id)) { sheet.deleteRow(i+1); break; } }
  return {ok: true};
}

function getFullConfig2() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(CFG_SHEET2);
  if (!sheet) return {genres: null, subgenres: null, members: null, otherMembers: null};
  const rows = sheet.getDataRange().getValues();
  const result = {};
  rows.forEach(r => {
    if (r[0] && r[1]) {
      try { result[r[0]] = JSON.parse(r[1]); } catch { result[r[0]] = r[1]; }
    }
  });
  return result;
}

function saveFullConfig2(data) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sheet = ss.getSheetByName(CFG_SHEET2);
  if (!sheet) sheet = ss.insertSheet(CFG_SHEET2);
  sheet.clearContents();
  Object.entries(data).forEach(([k, v], i) => {
    sheet.getRange(i+1, 1, 1, 2).setValues([[k, JSON.stringify(v)]]);
  });
  return {ok: true};
}

